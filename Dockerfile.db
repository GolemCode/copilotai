FROM timescale/timescaledb:latest-pg15

# Copie des scripts d'initialisation si nécessaire
COPY ./database/init_db.sql /docker-entrypoint-initdb.d/

USER root

# Installation minimale des dépendances sous Alpine Linux
RUN apk add --no-cache \
    git \
    build-base

# Clonage et compilation de pgvector en désactivant strictement LLVM
RUN git clone --branch v0.5.1 https://github.com/pgvector/pgvector.git /tmp/pgvector && \
    cd /tmp/pgvector && \
    make with_llvm=no && \
    make install with_llvm=no && \
    rm -rf /tmp/pgvector