# Copier ce fichier en .env puis renseigner les valeurs (le fichier .env n'est jamais versionné).

# --- PostgreSQL (base métier + pgvector) -------------------------------------------
DB_USER=copilot
DB_PASSWORD=change-me
DB_NAME=copilot_db
# "db" dans docker-compose ; "localhost" pour lancer l'API ou les scripts hors Docker
DB_HOST=db
DB_PORT=5432

# --- Redis (broker Celery + canal WebSocket des simulations) ----------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- LLM (GroqCloud) : réponses du copilote RAG --------------------------------------
GROQ_API_KEY=

# --- Administration --------------------------------------------------------------------
# Jeton exigé (en-tête X-Admin-Token) par POST /api/v1/rag/ingest ; endpoint désactivé si vide
ADMIN_API_TOKEN=

# --- Airflow (orchestration des pipelines quotidiens) -------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Adresse de l'API vue depuis les conteneurs Airflow
API_HOST=api
API_PORT=8000

# --- Front (Vite) ------------------------------------------------------------------------
# Cible du proxy /api et /ws du serveur de développement (http://localhost:8000 hors Docker)
VITE_API_TARGET=http://api:8000
